{
  "name": "mumbai-journey",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An interactive, realistic journey from Mira Road to Marine Drive. Milestone 1: Churchgate station vertical slice.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "geo": "node tools/build-geo.mjs",
    "fetch-osm": "node tools/fetch-osm.mjs",
    "shot": "node tools/screenshot.mjs",
    "share": "bash tools/share.sh",
    "share:stop": "bash tools/share.sh stop"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "n8ao": "2.0.1",
    "postprocessing": "6.39.5",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "puppeteer-core": "23.11.1",
    "typescript": "~5.9.0",
    "vite": "~6.4.3"
  }
}
